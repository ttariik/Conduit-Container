# syntax=docker/dockerfile:1.7-labs
ARG NODE_VERSION=20.12.2
ARG NGINX_VERSION=1.27.2

FROM node:${NODE_VERSION}-alpine AS deps
WORKDIR /srv/app

# Install frontend dependencies
COPY frontend/package*.json ./ 
RUN npm install -g npm@10 && npm ci --legacy-peer-deps

FROM deps AS build
ARG FRONTEND_BUILD_CONFIGURATION=production
ENV NG_CLI_ANALYTICS=false
COPY frontend/ .
RUN npm run build -- --configuration "${FRONTEND_BUILD_CONFIGURATION}"

FROM nginx:${NGINX_VERSION}-alpine AS runtime
LABEL org.opencontainers.image.title="Conduit Frontend" \
      org.opencontainers.image.description="Angular RealWorld frontend served via NGINX" \
      org.opencontainers.image.source="https://github.com/ttariik/Conduit-Container"

ENV FRONTEND_PORT=8080 \
    API_URL=https://conduit.productionready.io/api

COPY docker/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/frontend/docker-entrypoint.sh /docker-entrypoint.sh
COPY --from=build /srv/app/dist/angular-conduit /usr/share/nginx/html

RUN chmod +x /docker-entrypoint.sh \
    && mkdir -p /usr/share/nginx/html/assets

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --spider -q http://127.0.0.1:8080/ || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]

