# Frontend configuration
FRONTEND_PORT=8282
API_URL=http://localhost:8000/api
FRONTEND_BUILD_CONFIGURATION=production
FRONTEND_PRODUCTION=true

# Backend configuration
BACKEND_PORT=8000
BACKEND_PYTHON_VERSION=3.9-slim
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SECRET_KEY=please-change-me
DJANGO_DEBUG=False
DJANGO_MANAGEPY_MAKEMIGRATIONS=0
DJANGO_MANAGEPY_MIGRATE=1
DJANGO_MANAGEPY_COLLECTSTATIC=1
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=

# CORS configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:8282

# Database configuration (PostgreSQL)
POSTGRES_DB=conduit
POSTGRES_USER=conduit
POSTGRES_PASSWORD=conduit
POSTGRES_PORT=5432
DATABASE_URL=postgresql://conduit:conduit@db:5432/conduit

# Logging
GUNICORN_LOG_LEVEL=info
GUNICORN_TIMEOUT=30

# Container Registry (for production deployment)
GITHUB_REPOSITORY=ttariik/conduit-container
IMAGE_TAG=conduit

